# Copy this file to ".env" and put your real keys here. Never share .env!
TELEGRAM_TOKEN=123456789:ABC-your-token-from-BotFather

# Gemini (free tier) - get the key at aistudio.google.com -> "Get API key"
AI_API_KEY=your-gemini-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Copy the exact name of the newest "Flash" model from AI Studio:
MODEL=gemini-3.5-flash
FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest

# (If you use OpenAI instead: put the OpenAI key above, leave AI_BASE_URL empty, and set MODEL to an OpenAI model.)
